# Appwrite Cloud project (Console → Settings)
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server API key: TablesDB + VectorsDB read/write, embeddings, users.read
APPWRITE_API_KEY=

# Appwrite user id that owns memories written by the MCP server (shown on the dashboard after login)
DEJA_OWNER_ID=
# Project namespace for memories. Defaults to the basename of the agent's working directory.
DEJA_PROJECT=

# Optional: enables fact extraction + contradiction judge. Without it Déjà uses heuristics.
ANTHROPIC_API_KEY=
DEJA_MODEL=claude-opus-5-5
# Demo: multiply elapsed time for the forgetting curve (1440 => 1 minute = 1 day)
DEJA_TIME_WARP=1

# Vector search: `tables` (default; TablesDB + Appwrite Embeddings, no extra service), `qdrant`
# (`docker compose up -d` or Qdrant Cloud) or `appwrite` (VectorsDB, needs a paid Appwrite plan)
DEJA_VECTOR_BACKEND=tables
QDRANT_URL=http://localhost:6333
