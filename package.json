{
  "name": "deja",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "setup:appwrite": "tsx --env-file=.env scripts/setup.ts",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "mcp": "tsx --env-file-if-exists=.env apps/mcp/src/index.ts",
    "web": "pnpm --filter @deja/web dev",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "test": "pnpm -r test",
    "mcp:e2e": "tsx scripts/mcp-e2e.ts",
    "check:vectorsdb": "tsx --env-file=.env scripts/check-vectorsdb.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@deja/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-appwrite": "31.0.0"
  }
}
